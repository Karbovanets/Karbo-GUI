* {
  font-family: %fontFamily%;
  color: %primaryTextColor%;
}

QMainWindow, QWidget#centralwidget {
  background-color: %backgroundColorGray%;
}

QMenu, QMenuBar {
  background-color: %menuBackgroundColor%;
  color: %primaryTextColor%;
  border: 1px solid %borderColorDark%;
}

QMenu::item:selected, QMenuBar::item:selected {
  background-color: %selectionColor%;
  color: %selectionTextColor%;
}

QToolTip {
  background-color: %menuBackgroundColor%;
  color: %primaryTextColor%;
  border: 1px solid %borderColorDark%;
}

QDialog {
  background-color: %backgroundColorGray%;
  color: %primaryTextColor%;
}

QTextEdit, QPlainTextEdit {
  background-color: %inputBackgroundColor%;
  color: %primaryTextColor%;
  border-radius: 2px;
  border: 1px solid %borderColorDark%;
  selection-background-color: %selectionColor%;
  selection-color: %selectionTextColor%;
}

QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox, QPushButton, QDateTimeEdit, QRadioButton, QCheckBox {
  font-size: %fontSizeNormal%;
  border-radius: 2px;
  min-height: 30px;
  max-height: 30px;
  border: 1px solid %borderColorDark%;
  background-color: %inputBackgroundColor%;
  color: %primaryTextColor%;
  selection-background-color: %selectionColor%;
  selection-color: %selectionTextColor%;
}

QRadioButton, QCheckBox {
  border: none;
  background-color: transparent;
}

/*
 * Qt disables the native radio/check indicator the moment QSS styles the parent
 * widget class, so without explicit ::indicator rules the dots/checkmarks go
 * invisible (settings > Connection radios looked like bare labels). These rules
 * draw a small circle/square using stylesheet primitives — no extra icons.
 */
QRadioButton::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid %borderColorDark%;
  border-radius: 8px;
  background-color: %inputBackgroundColor%;
}

QRadioButton::indicator:checked {
  background-color: %selectionColor%;
  border: 1px solid %selectionColor%;
}

QRadioButton::indicator:hover {
  border: 1px solid %selectionColor%;
}

QRadioButton::indicator:disabled {
  background-color: %backgroundColorGray%;
}

QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid %borderColorDark%;
  border-radius: 2px;
  background-color: %inputBackgroundColor%;
}

QCheckBox::indicator:checked {
  background-color: %selectionColor%;
  border: 1px solid %selectionColor%;
}

QCheckBox::indicator:disabled {
  background-color: %backgroundColorGray%;
}

QDateTimeEdit {
  border: 1px solid %borderColorDark%;
  background-color: %inputBackgroundColor%;
  min-width: 155px;
  max-width: 155px;
  font-size: %fontSizeNormal%;
  padding-left: 10px;
  selection-background-color: %selectionColor%;
  selection-color: %selectionTextColor%;
}


QDateTimeEdit::drop-down {
  width: 20;
  border-top-right-radius: 2px;
  border-bottom-right-radius: 2px;
  border-color: %borderColorDark%;
  image: url(:icons/down-arrow);
}

QMessageBox QLabel {
  font-size: %fontSizeLarge%;
  color: %primaryTextColor%;
}

QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox, QDateTimeEdit {
  padding-left: 5px;
}


QComboBox {
  border: 1px solid %borderColorDark%;
  background-color: %inputBackgroundColor%;
  font-size: %fontSizeNormal%;
  padding-left: 10px;
  selection-background-color: %selectionColor%;
  selection-color: %selectionTextColor%;
}

QComboBox::drop-down {
  width: 20;
  border-top-right-radius: 2px;
  border-bottom-right-radius: 2px;
  border-color: %borderColorDark%;
  image: url(:icons/down-arrow);
}

QComboBox QAbstractItemView {
  border: 1px solid %borderColorDark%;
  border-radius: 2px;
  background-color: %menuBackgroundColor%;
  color: %primaryTextColor%;
  selection-background-color: %selectionColor%;
  selection-color: %selectionTextColor%;
}

QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button,
QSpinBox::up-button,
QSpinBox::down-button,
QTimeEdit::up-button,
QTimeEdit::down-button {
  border-width: 1px;
  padding-right: 5px;
}

QDoubleSpinBox::up-arrow,
QSpinBox::up-arrow,
QTimeEdit::up-arrow{
  image: url(:icons/up-arrow);
}

QDoubleSpinBox::down-arrow,
QSpinBox::down-arrow,
QTimeEdit::down-arrow{
  image: url(:icons/down-arrow);
}

QScrollBar:vertical {
  max-width: 6px;
  background: %scrollBarBackgroundColor%;
  margin-top: 20px;
  border-top: 1px solid %borderColor%;
}

QScrollBar::handle:vertical {
  background-color: %backgroundColorBlueNormal%;
  min-height: 20px;
}

QCalendarWidget QMenu {
  border: 1px solid %borderColorDark%;
  border-radius: 2px;
  background-color: %menuBackgroundColor%;
  selection-background-color: %selectionColor%;
  selection-color: %selectionTextColor%;
}

QScrollBar::sub-line, QScrollBar::add-line {
  width: 0px;
  height: 0px;
}

QSlider {
  margin-right: 1px;
  height: 16px;
}

QSlider::groove:horizontal {
  height: 5px;
  background-color: transparent;
  border: 1px solid %borderColorDark%;
  border-radius: 3px
}

QSlider::handle:horizontal {
  margin: -5px -2px;
  image: url(:icons/slider-handle);
}

QSlider::sub-page:horizontal:enabled {
  background-color: %backgroundColorBlueNormal%;
  border: 1px solid %backgroundColorBlueNormal%;
  border-radius: 3px
}

QSlider::sub-page:horizontal:!enabled {
  background-color: %borderColorDark%;
  border: 1px solid %borderColorDark%;
}

QSlider::add-page:horizontal {
  border-radius: 3px
}

QCalendarWidget #qt_calendar_navigationbar {
  min-height: 27px;
  background-color: %calendarHeaderBackgroundColor%;
}
QCalendarWidget QAbstractItemView {
  background-color: %panelBackgroundColor%;
  color: %primaryTextColor%;
  selection-background-color: %selectionColor%;
  selection-color: %selectionTextColor%;
}

QCalendarWidget {
  leftarrow-icon: url(:icons/arrow-left-black);
  rightarrow-icon: url(:icons/arrow-right-black);
}

QCalendarWidget QToolButton {
  border: none;
}

QCalendarWidget QToolButton::menu-indicator {
  image: none;
}

QCalendarWidget QToolButton:hover {
  background-color: %selectionColor%;
}


QCalendarWidget QSpinBox {
  border-radius: 2px;
  min-height: 25px;
  max-height: 25px;
  border: 1px solid %borderColorDark%;
}

QCalendarWidget QMenu {
  border: 1px solid %borderColorDark%;
  border-radius: 2px;
  background-color: %menuBackgroundColor%;
  selection-background-color: %selectionColor%;
  selection-color: %selectionTextColor%;
}


#MainWindow > #centralwidget > #m_headerFrame {
  background-color: %headerBackgroundColor%;
  border: none;
  border-bottom: 1px solid %headerBorderColor%;
  min-height: 105px;
  max-height: 105px;
}

#MainWindow > #centralwidget > #m_headerFrame #m_balanceTextLabel {
  font-size: %fontSizeLarge%;
  font-weight: bold;
  color: %balanceFontColor%;
}

#MainWindow > #centralwidget > #m_headerFrame #m_balanceLabel {
  font-size: %fontSizeHuge%;
  color: %balanceFontColor%;
}

#MainWindow > #centralwidget > #m_headerFrame > #m_walletFrame > #m_addressLabel {
  font-size: %fontSizeLarge%;
  color: %addressFontColor%;
}

#MainWindow > #centralwidget > #m_headerFrame > #m_walletFrame > #m_copyAddressLabel {
  font-size: %fontSizeTiny%;
  color: %fontColorBlueHover%;
}

#MainWindow > #centralwidget > #m_toolFrame {
  background-color: %toolButtonBackgroundColorNormal%;
  border: none;
  border-right: 1px solid %toolBarBorderColor%;
  min-width: 200px;
  max-width: 200px;
}

#MainWindow > #centralwidget > #m_toolFrame > QPushButton {
  min-height: 41px;
  max-height: 41px;
  background-color: transparent;
  border: none;
  border-top: 15px solid transparent;
  border-bottom: 15px solid transparent;
  border-left: 10px solid transparent;
  border-right: 10px solid transparent;
  padding-left: 40px;
  padding-right: 0px;
  color: %toolButtonFontColorNormal%;
  font-size: %fontSizeSmall%;
  border-radius: 0px;
  background-position: left center;
  background-repeat: no-repeat;
  text-align: left;
}

#MainWindow > #centralwidget > #m_toolFrame > QPushButton:disabled {
  color: %toolButtonFontColorDisabled%;
}

#MainWindow > #centralwidget > #m_headerFrame > #m_walletFrame > #m_addressLabel {
  font-size: %fontSizeLarge%;
  color: %addressFontColor%;
}

#MainWindow > #centralwidget > #m_toolFrame > QPushButton:hover {
  background-color: %toolButtonBackgroundColorHover%;
}

#MainWindow > #centralwidget > #m_toolFrame > QPushButton:checked {
  background-color: %toolButtonBackgroundColorPressed%;
}

#MainWindow > #centralwidget > #m_toolFrame > #m_overviewButton {
  background-image: url(:icons/overview);
}

#MainWindow > #centralwidget > #m_toolFrame > #m_transactionsButton {
  background-image: url(:icons/transactions);
}

#MainWindow > #centralwidget > #m_toolFrame > #m_blockExplorerButton {
  background-image: url(:icons/explorer);
}

#MainWindow > #centralwidget > #m_toolFrame > #m_receiveButton {
  background-image: url(:icons/receive);
}

#MainWindow > #centralwidget > #m_toolFrame > #m_addressBookButton {
  background-image: url(:icons/address_book);
}

#MainWindow > #centralwidget > #m_toolFrame > #m_sendButton {
  background-image: url(:icons/send);
}

#MainWindow > #centralwidget > #m_toolFrame > #m_overviewButton:checked {
  color: %selectionTextColor%;
}

#MainWindow > #centralwidget > #m_toolFrame > #m_transactionsButton:checked {
  color: %selectionTextColor%;
}

#MainWindow > #centralwidget > #m_toolFrame > #m_blockExplorerButton:checked {
  color: %selectionTextColor%;
}

#MainWindow > #centralwidget > #m_toolFrame > #m_receiveButton:checked {
  color: %selectionTextColor%;
}

#MainWindow > #centralwidget > #m_toolFrame > #m_addressBookButton:checked {
  color: %selectionTextColor%;
}

#MainWindow > #centralwidget > #m_toolFrame > #m_sendButton:checked {
  color: %selectionTextColor%;
}

#MainWindow > #centralwidget > #m_toolFrame > #m_overviewButton:checked:disabled {
  background-color: transparent;
  color: %toolButtonFontColorDisabled%;
}

#MainWindow > #centralwidget > #m_toolFrame > #m_transactionsButton:checked:disabled {
  background-color: transparent;
  color: %toolButtonFontColorDisabled%;
}

#MainWindow > #centralwidget > #m_toolFrame > #m_blockExplorerButton:checked:disabled {
  background-color: transparent;
  color: %toolButtonFontColorDisabled%;
}

#MainWindow > #centralwidget > #m_toolFrame > #m_addressBookButton:checked:disabled {
  background-color: transparent;
  color: %toolButtonFontColorDisabled%;
}

#MainWindow > #centralwidget > #m_toolFrame > #m_sendButton:checked:disabled {
  background-color: transparent;
  color: %toolButtonFontColorDisabled%;
}


#MainWindow > #centralwidget > #m_syncProgress {
  border-top: 1px solid %borderColor%;
  background-color: %statusBarBackgroundColor%;
  min-height: 5px;
  max-height: 5px;
  border-radius: 0px;
}

#MainWindow > #centralwidget > #m_syncProgress::chunk {
  background-color: %backgroundColorBlueNormal%;
}

#MainWindow > #centralwidget > #m_headerFrame > #m_balanceFrame > #m_balanceCopyLabel {
  font-size: %fontSizeTiny%;
  color: %fontColorBlueHover%;
}

#m_overviewBalanceFrame,
#m_overviewNodeFrame,
#m_overviewPoolFrame
{
  background-color: %backgroundColorAlternate%;
  border: none;
}

#m_receiveFrame {
  background-color: %panelBackgroundColor%;
  border: none;
}

#m_receiveFrame > #m_createRequestFrame {
  background-color: %panelBackgroundColor%;
  border: none;
}

#m_receiveFrame > #m_receiveFrameButtons {
  background-color: %panelBackgroundColor%;
  border: none;
  border-top: 1px solid %borderColor%;
}

#m_blockExplorerFrame {
  background-color: %backgroundColorGray%;
  border: none;
}

#m_blockchainTab > #m_filterFrame > #m_filterPeriodComboFrame > #m_filterCombo {
  min-width: 100px;
  max-width: 100px;
}

#m_blockExplorerFrame > #m_blockExplorerTabBar > #m_blockchainTab > #m_filterFrame > #m_filterHashFrame > QLineEdit {
  font-size: %fontSizeNormal%;
}

#m_blockExplorerFrame > #m_blockExplorerTabBar {
  border: none;
}

#m_blockExplorerFrame > #m_blockExplorerTabBar::pane {
  border: none;
  border-top: 1px solid %borderColorDark%;
  top: -1px;
}

#m_blockExplorerFrame > #m_blockExplorerTabBar::tab-bar {
  left: 25px;
  alignment: left;
}

#m_blockExplorerFrame > #m_blockExplorerTabBar QTabBar::tab {
  font-size: %fontSizeLarge%;
  font-weight: bold;
  min-width: 200px;
  max-width: 200px;
  min-height: 30px;
  max-height: 30px;
  border: 1px solid %borderColorDark%;
  margin-left: 2px;
  margin-right: 2px;
  border-top-left-radius: 2px;
  border-top-right-radius: 2px;
}

#m_blockExplorerFrame > #m_blockExplorerTabBar QTabBar::tab:selected {
  background: %tabBackgroundColor%;
  border: 1px solid %borderColorDark%;
  border-bottom: 1px solid %tabBackgroundColor%;
}

#m_blockExplorerFrame > #m_blockExplorerTabBar QTabBar::tab:!selected {
  background: %tabInactiveBackgroundColor%;
  border: 1px solid %borderColorDark%;
}

#m_blockchainTab, #m_transactionPoolTab {
  background-color: %panelBackgroundColor%;
  border: none;
}


#m_addressBookFrame {
  background-color: %panelBackgroundColor%;
  border: none;
}

#m_addressBookMenuButton {
  min-height: 46px;
  background-color: transparent;
  border: none;
  image: url(:icons/big-down-arrow);
}

#m_addressBookMenuButton:hover {
  image: url(:icons/big-down-arrow-black);
}

#m_addressBookMenuButton:!hover {
  image: url(:icons/big-down-arrow);
}

#m_addressBookMenuButton::menu-indicator {
  image: none;
}

#m_addressBookMenu {
  border: 1px solid %borderColorDark%;
  border-radius: 2px;
  background-color: %menuBackgroundColor%;
  selection-background-color: %selectionColor%;
  selection-color: %selectionTextColor%;
}

#AddressBookDialog {
  background-color: %panelBackgroundColor%;
}

#m_noWalletFrame {
  background-color: %panelBackgroundColor%;
}


#m_passwordFrame > QLabel,
#ChangePasswordDialog > QLabel,
#NewPasswordDialog > QLabel {
  font-size: %fontSizeNormal%;
  color: %fontColorGray%;
}

#m_passwordFrame > #m_walletNameLabel {
  font-weight: bold;
  color: %primaryTextColor%;
}


QMessageBox > QDialogButtonBox > QPushButton {
  min-width: 80px;
  max-width: 80px;
  min-height: 30px;
  max-height: 30px;
  font-size: %fontSizeNormal%;
  color: %selectionTextColor%;
  background-color: %backgroundColorBlueNormal%;
  border: 1px solid %backgroundColorBlueNormal%;
}


QMessageBox > QDialogButtonBox > QPushButton:hover {
  background-color: %backgroundColorBlueHover%;
  border: 1px solid %backgroundColorBlueHover%;
}

QMessageBox > QDialogButtonBox > QPushButton:pressed {
  background-color: %backgroundColorBluePressed%;
  border: 1px solid %backgroundColorBluePressed%;
}

#newTransactionLabel {
  background-color: #e6e6b2;
}

#P2pBindPortErrorDialog > QSpinBox {
  min-height: 25px;
  max-height: 25px;
}

/* -------- Top navigation toolbar (uses old m_toolFrame palette) -------- */

QToolBar#m_mainToolBar {
  background-color: %toolButtonBackgroundColorNormal%;
  border: none;
  border-bottom: 1px solid %toolBarBorderColor%;
  spacing: 0;
  padding: 0;
}

QToolBar#m_mainToolBar::separator {
  background: transparent;
  width: 0;
}

QToolBar#m_mainToolBar QToolButton {
  min-height: 41px;
  max-height: 41px;
  padding: 0 18px;
  background-color: transparent;
  border: none;
  color: %toolButtonFontColorNormal%;
  font-size: %fontSizeSmall%;
  text-align: left;
}

QToolBar#m_mainToolBar QToolButton:hover {
  background-color: %toolButtonBackgroundColorHover%;
}

QToolBar#m_mainToolBar QToolButton:checked {
  background-color: %toolButtonBackgroundColorPressed%;
  color: %selectionTextColor%;
}

QToolBar#m_mainToolBar QToolButton:disabled {
  color: %toolButtonFontColorDisabled%;
}

QToolBar#m_mainToolBar QToolButton:checked:disabled {
  background-color: transparent;
  color: %toolButtonFontColorDisabled%;
}

/* -------- Top toolbar balance block -------- */

#m_toolBarBalanceFrame {
  background-color: transparent;
  border: none;
}

#m_toolBarBalanceFrame QLabel {
  background-color: transparent;
  color: %balanceFontColor%;
}

#m_toolBarBalanceFrame #m_lockedCaption,
#m_toolBarBalanceFrame #m_totalCaption {
  font-size: %fontSizeTiny%;
  color: %fontColorGray%;
}

#m_toolBarBalanceFrame #m_lockedValue {
  font-size: %fontSizeNormal%;
  color: %fontColorGray%;
}

#m_toolBarBalanceFrame #m_totalValue {
  font-size: %fontSizeLarge%;
  font-weight: bold;
  color: %balanceFontColor%;
}

/* -------- Address sidebar -------- */

#m_addressSidebar {
  background-color: %toolButtonBackgroundColorNormal%;
  border: none;
}

#m_addressSidebar QScrollArea {
  background-color: transparent;
  border: none;
}

#m_addressSidebarList {
  background-color: transparent;
}

#m_addAddressButton {
  background-color: transparent;
  border: 1px solid transparent;
  color: %fontColorBlueNormal%;
  font-size: %fontSizeLarge%;
  padding: 3px 0;
  min-height: 28px;
  text-align: center;
}

#m_addAddressButton:hover {
  color: %fontColorBlueHover%;
}

#m_addAddressButton:pressed {
  color: %fontColorBluePressed%;
}

/* -------- Address card -------- */

QFrame#m_addressCard {
  background-color: %panelBackgroundColor%;
  border: 1px solid %borderColor%;
  border-radius: 2px;
}

QFrame#m_addressCard:hover {
  border: 1px solid %backgroundColorBlueHover%;
}

QFrame#m_addressCard[selected="true"] {
  background-color: %backgroundColorAlternate%;
  border: 2px solid %backgroundColorBlueNormal%;
}

QFrame#m_addressCard QLabel {
  background-color: transparent;
  color: %primaryTextColor%;
}

QFrame#m_addressCard #m_addressCardLabel {
  font-size: %fontSizeNormal%;
  font-weight: bold;
  color: %balanceFontColor%;
}

QFrame#m_addressCard #m_addressCardAddress {
  font-size: %fontSizeTiny%;
  color: %addressFontColor%;
}

QFrame#m_addressCard QToolButton {
  background-color: transparent;
  border: 1px solid transparent;
  color: %fontColorBlueNormal%;
  font-size: %fontSizeTiny%;
  padding: 2px 6px;
  min-height: 18px;
}

QFrame#m_addressCard QToolButton:hover {
  color: %fontColorBlueHover%;
}

QFrame#m_addressCard QToolButton:pressed {
  color: %fontColorBluePressed%;
}

QFrame#m_addressCard QToolButton::menu-indicator {
  image: none;
  width: 0;
}
